# PrintStudio Worker — Cloud-only

NODE_ENV=development
LOG_LEVEL=info

# Postgres com bambu_credentials da org (mesmo DB do api)
DATABASE_URL=postgres://printstudio:CHANGE_ME@localhost:5432/printstudio

# Chave AES-256 pra decryptar tokens (MESMO valor do api).
# Gere com: openssl rand -base64 32
BAMBU_CRED_KEY=CHANGE_ME_32bytes_base64

# WS pra mandar telemetria pra api (mesmo CLOUD_WS_URL do bridge LAN)
CLOUD_WS_URL=ws://localhost:4000/ws/bridge
CLOUD_API_TOKEN=CHANGE_ME_bridge_auth_token

# ID único pro worker (aparece nos logs do api como bridgeId)
WORKER_ID=worker-cloud-01

# Org a operar (MVP: 1 org por worker). UUID determinístico da Default.
ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
