{
  "name": "@printstudio/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PrintStudio cloud worker — conecta na Bambu Cloud MQTT por organização e relaya telemetria pro api via WS (substitui bridge LAN)",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint yet'"
  },
  "dependencies": {
    "@printstudio/bambu-protocol": "workspace:*",
    "@printstudio/db": "workspace:*",
    "@printstudio/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "mqtt": "^5.10.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
